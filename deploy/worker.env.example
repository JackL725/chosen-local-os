# Production worker environment: NAMES ONLY. Jack creates the real file at
# /home/clworker/.config/chosen-local/worker.env (owner clworker, mode 600).
# Never commit values. Claude Code cannot read the real file.

DATABASE_URL=            # Ledger over Tailscale
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=
ASR_ENGINE=
HF_TOKEN=                # Hugging Face read token, for the gated pyannote model
PRIVATE_DATA_DIR=/home/clworker/cl-private
CLOSE_API_KEY=
SLACK_ALERT_WEBHOOK_URL=
REVIEW_CONSOLE_SECRET=
ANTHROPIC_API_KEY=       # optional; cloud_llm only, never for prospect data

# The VPS holds its own env for n8n: Close webhook secret, Cal.com key and webhook secret,
# Slack bot token and signing secret, Meta and TikTok tokens, QuickBooks credentials.
