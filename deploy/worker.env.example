# Production worker environment: NAMES ONLY. Jack creates the real file at
# /home/clworker/.config/chosen-local/worker.env (owner clworker, mode 600).
# scripts/deploy_local.sh copies this example there the first time.
# Never commit values. Claude Code cannot read the real file.
# Read by cl-worker, cl-review, llama-server and cl-restic (systemd EnvironmentFile).

DATABASE_URL=            # postgres://cl_worker:<password>@<VPS Tailscale IP>:5432/ledger?sslmode=disable
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=qwen3.6-27b-q4_k_m
LOCAL_LLM_THINKING=false
ASR_ENGINE=
HF_TOKEN=                # Hugging Face read token, for the gated pyannote model (Phase 2c)
PRIVATE_DATA_DIR=/home/clworker/cl-private
CLOSE_API_KEY=           # Phase 2
SLACK_ALERT_WEBHOOK_URL= # incoming webhook for #cl-alerts
REVIEW_CONSOLE_BASE_URL= # https://<workstation tailnet name>:8443  (links in Slack alerts)
CONSOLE_DATABASE_URL=    # postgres://cl_console:<password>@<VPS Tailscale IP>:5432/ledger?sslmode=disable
CONSOLE_ALLOW_LOCAL_SIGNIN=true   # password-only sign-in on the workstation, for founders flagged
                                  # with --allow-local (decision 11: Jack only)
CONSOLE_MAX_UPLOAD_MB=500
ANTHROPIC_API_KEY=       # optional; cloud_llm only, never for prospect data

# llama-server (deploy/systemd/llama-server.service)
LLAMA_MODEL_PATH=/opt/models/qwen3.6-27b-q4_k_m.gguf
LLAMA_CTX_SIZE=32768     # total context, shared by the parallel slots
LLAMA_PARALLEL=4
WORKER_CONCURRENCY=4     # jobs at once; keep equal to LLAMA_PARALLEL

# Backups of PRIVATE_DATA_DIR (scripts/backup_private.sh) live in a separate file:
# /home/clworker/.config/chosen-local/restic.env (mode 600) with
#   RESTIC_REPOSITORY=s3:https://<B2 S3 endpoint>/<bucket>/workstation
#   RESTIC_PASSWORD_FILE=/home/clworker/.config/chosen-local/restic.password
#   AWS_ACCESS_KEY_ID=          (B2 application key ID, scoped to the bucket)
#   AWS_SECRET_ACCESS_KEY=      (B2 application key)

# The VPS holds its own env for n8n: Close webhook secret, Cal.com key and webhook secret,
# Slack bot token and signing secret, Meta and TikTok tokens, QuickBooks credentials.
