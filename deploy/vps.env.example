# VPS environment for deploy/compose.prod.yml: NAMES ONLY.
# Jack creates /etc/chosen-local/vps.env (root:root, mode 600) on the VPS.

N8N_VERSION=2.35.0             # pin; bump deliberately after reading n8n's release notes
POSTGRES_SUPERUSER_PASSWORD=   # openssl rand -base64 32
LEDGER_OWNER_PASSWORD=         # cl_migrate: runs migrations, owns the ledger database
N8N_DB_PASSWORD=               # n8n's own database
N8N_ENCRYPTION_KEY=            # openssl rand -hex 32; keep a copy in the password manager
VPS_TAILNET_NAME=              # e.g. cl-vps.tailXXXX.ts.net (n8n editor URL)
N8N_PUBLIC_HOST=               # e.g. hooks.<your domain>; leave empty until the domain exists

# /etc/chosen-local/backup.env (root:root, mode 600), read by deploy/backup/pg_backup.sh:
#   RESTIC_REPOSITORY=s3:https://<B2 S3 endpoint>/<bucket>/vps
#   RESTIC_PASSWORD_FILE=/etc/chosen-local/restic.password
#   AWS_ACCESS_KEY_ID=
#   AWS_SECRET_ACCESS_KEY=
#   SLACK_ALERT_WEBHOOK_URL=
