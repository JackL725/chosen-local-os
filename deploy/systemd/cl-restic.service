[Unit]
Description=Chosen Local: encrypted backup of private data
Wants=network-online.target
After=network-online.target
OnFailure=cl-unit-failed@%n.service

[Service]
Type=oneshot
User=clworker
Group=clworker
SupplementaryGroups=clprivate
UMask=0027
EnvironmentFile=/home/clworker/.config/chosen-local/worker.env
ExecStart=/opt/chosen-local/scripts/backup_private.sh
Nice=10
