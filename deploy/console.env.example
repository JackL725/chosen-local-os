# Review console environment: NAMES ONLY. Jack creates the real file at
# /etc/chosen-local/console.env (owner root, mode 600); scripts/deploy_local.sh copies this
# example there the first time. systemd reads it as root for cl-review, which then runs as
# clconsole. No other service and no clworker process can read it: CONSOLE_DATABASE_URL is
# the only Ledger login that may act as a founder.

CONSOLE_DATABASE_URL=    # postgres://cl_console:<password>@<VPS Tailscale IP>:5432/ledger?sslmode=disable
CONSOLE_ALLOW_LOCAL_SIGNIN=true   # password-only sign-in on the workstation, for founders flagged
                                  # with --allow-local (decision 11: Jack only)
CONSOLE_MAX_UPLOAD_MB=500
