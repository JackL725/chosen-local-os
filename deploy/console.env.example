# Review console environment: NAMES ONLY. Jack creates the real file at
# /home/clworker/.config/chosen-local/console.env (owner clworker, mode 600).
# scripts/deploy_local.sh copies this example there the first time.
# Read only by cl-review (and scripts/console_admin.sh). Every other service is denied the
# file by systemd InaccessiblePaths=, because CONSOLE_DATABASE_URL is the only Ledger login
# that may act as a founder.

CONSOLE_DATABASE_URL=    # postgres://cl_console:<password>@<VPS Tailscale IP>:5432/ledger?sslmode=disable
CONSOLE_ALLOW_LOCAL_SIGNIN=true   # password-only sign-in on the workstation, for founders flagged
                                  # with --allow-local (decision 11: Jack only)
CONSOLE_MAX_UPLOAD_MB=500
