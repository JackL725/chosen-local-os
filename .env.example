# Copy to .env for LOCAL DEVELOPMENT only. Claude Code is denied from reading .env.
# Dev holds NO production credentials and NO real data.
# Production worker values live in /home/clworker/.config/chosen-local/worker.env
# (names listed in deploy/worker.env.example). Production server values live only on the VPS.

# --- Local dev Ledger (docker compose -f deploy/compose.dev.yml up) ---
DATABASE_URL=postgres://cl:devpassword@localhost:5432/chosen_local_dev?sslmode=disable

# --- Local models ---
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=qwen3.6-27b-q4_k_m
ASR_ENGINE=whisper            # whisper | parakeet, chosen by eval

# --- Data: dev points at synthetic data only ---
PRIVATE_DATA_DIR=./evals/synthetic

# --- Dev-only Slack webhook for a #cl-dev channel (alerts carry IDs only) ---
SLACK_ALERT_WEBHOOK_URL=

# --- Tests (a disposable database whose name ends in _test; compose.dev.yml creates it) ---
TEST_DATABASE_URL=postgres://cl:devpassword@localhost:5432/chosen_local_test?sslmode=disable
# RUN_LOCAL_MODEL_TESTS=1      # also run tests/integration against llama-server

# --- Dev worker: register the test-only job types (test_sleep, test_fail) ---
WORKER_ENABLE_TEST_JOBS=1
